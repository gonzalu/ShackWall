# ShackWall settings. Copy this file to shackwall.env (which git ignores)
# and fill it in. One KEY=value per line, the format systemd's
# EnvironmentFile= reads. An environment variable of the same name wins.

# Your station.
CALLSIGN=
GRID=
LICENCE_CLASS=
# Shown in the header beside the grid. All optional.
CITY=
CQ_ZONE=
ITU_ZONE=

# Your location, for weather, satellite passes and the APRS/AIS/ADS-B maps.
# Left blank, the middle of your grid square stands in, which is close enough
# for day and night but not for a weather forecast.
LAT=
LON=
TIMEZONE=America/New_York

# Wind gusts, in mph, at which the weather panel says to watch the antennas
# and to lower them. Set them for what your antennas can take.
WIND_WATCH_MPH=30
WIND_LOWER_MPH=45

# Satellites to predict passes for, by NORAD catalogue number (look them up
# at celestrak.org). Blank means the ISS, SO-50, AO-27, AO-123, RS-44, AO-7,
# FO-29, JO-97, AO-73 and AO-91. Passes lower than SAT_MIN_ELEVATION degrees
# are left out.
SATELLITES=
SAT_MIN_ELEVATION=10

# APRS stations on the map, from a receive-only APRS-IS connection. The login
# is your callsign with an SSID no radio of yours uses (blank means CALLSIGN-SW).
# Pick the server for your region: noam.aprs2.net, euro.aprs2.net,
# asia.aprs2.net, aunz.aprs2.net, soam.aprs2.net, or rotate.aprs2.net.
APRS_LOGIN=
APRS_SERVER=rotate.aprs2.net
APRS_RANGE_KM=100

# Aircraft overhead, from your own ADS-B receiver on your network: either
# FlightBoard's API, e.g. http://192.168.1.10:8090/api/aircraft, or a
# receiver's aircraft.json, e.g. http://piaware.local/skyaware/data/aircraft.json
# Leave blank if you have no receiver; the aircraft page is then left out.
AIRCRAFT_URL=

# A contact address sent in the User-Agent, so data providers can reach you
# instead of blocking you.
CONTACT_EMAIL=

# AIS ships, from aisstream.io (free key). Leave empty to hide the AIS page.
AISSTREAM_API_KEY=
